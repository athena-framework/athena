# Creates the table executed migrations are recorded in, if it doesn't exist.
#
# ```text
# $ ./bin/console orm:migrations:sync-metadata-storage
# ```
@[ACONA::AsCommand("orm:migrations:sync-metadata-storage", description: "Ensures that the metadata storage is at the latest version.")]
class Athena::ORM::Migrations::Commands::SyncMetadataStorage < Athena::ORM::Migrations::Commands::AbstractCommand
  def initialize(
    @metadata_storage : AORM::Migrations::Metadata::Storage::Interface,
  )
    super()
  end

  protected def configure : Nil
    self
      .help(<<-HELP)
        The way metadata is stored in the database can change between releases.
        The <info>%command.name%</info> command updates metadata storage to the latest version,
        ensuring it is ready to receive migrations generated by the current version of the migrations.

            <info>%command.full_name%</info>
        HELP
  end

  protected def execute(input : ACON::Input::Interface, output : ACON::Output::Interface) : ACON::Command::Status
    @metadata_storage.ensure_initialized

    self.io.success "Metadata storage synchronized"

    ACON::Command::Status::SUCCESS
  end
end
